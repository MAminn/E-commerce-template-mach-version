DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lebsy
PUBLIC_ORIGIN=http://localhost:5173
BASE_URL=http://127.0.0.1:3000

# Single Shop Mode
# Set to "true" to disable multi-vendor features and operate as a single shop
# When enabled:
# - Vendor registration is disabled
# - Only admins can access dashboard
# - Vendor-specific routes return 404
# - "Become a vendor" links are hidden
SINGLE_SHOP_MODE=true
VITE_SINGLE_SHOP_MODE=true

# Store branding (optional)
# VITE_STORE_NAME=My Store
# VITE_CURRENCY=EGP

# Store Owner ID (Single-Shop Mode)
# Default vendor/store owner UUID for database FK constraints
# Only needed if you want a custom store ID (optional, has secure default)
# STORE_OWNER_ID=00000000-0000-0000-0000-000000000001

# Email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
# Optional: visible "From" address/name, if different from SMTP_USER above
# (e.g. logging in via a transactional provider's SMTP relay/API key, but
# wanting mail to visibly come from cr@yourdomain.com). Falls back to
# SMTP_USER when unset.
# EMAIL_FROM_ADDRESS=cr@yourdomain.com
# EMAIL_FROM_NAME=Your Store Name
# Marketing-automation sending (abandoned cart, win-back, etc) is controlled
# live from the admin's Marketing Emails page (Automation Settings card) —
# an on/off switch plus a test-mode switch that restricts sending to one
# address — not an env var, so it can be toggled without a redeploy.

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Superadmin credentials (optional)
# Grants access to the hidden /dashboard/superadmin/sync page, which can
# export the ENTIRE database as a zip (for pulling a full prod snapshot down
# into dev), and — outside production only — import one to fully overwrite
# the local DB. Leave unset to skip bootstrapping this account entirely
# (recommended on any environment that doesn't need it). Requires
# pg_dump/pg_restore on PATH.
SUPERADMIN_EMAIL=superadmin@email.com
SUPERADMIN_PASSWORD=superadmin@1234

# Dev-only image fallback (optional)
# Uploaded files (products, logos, etc.) live on a persistent volume and are
# NOT copied down by the superadmin export above — only DB records are. When
# a synced DB references a file that isn't present in this environment's
# local uploads/ folder, set this to the live site's origin so the app
# fetches the real image from there instead of showing a broken image.
# Has no effect when NODE_ENV=production.
# PROD_ASSET_ORIGIN=https://your-live-domain.com

# Fincart integration
# Fincart shipping (opt-in — set FINCART_ENABLED=true to activate)
# FINCART_ENABLED=false
# FINCART_API_URL=https://api-v3.fincart.io
# FINCART_API_KEY=your-api-key
# FINCART_WEBHOOK_SECRET=your-webhook-secret
# FINCART_PICKUP_ID=your-pickup-id
# FINCART_MERCHANT_LOCATION=your-merchant-location

# Bosta shipping (opt-in — active when SYN_BOSTA_KEY is set)
# SYN_BOSTA_KEY=your-bosta-api-key
# BOSTA_WEBHOOK_SECRET=your-webhook-secret
# BOSTA_EGYPT_COUNTRY_ID=60e4482c7cb7d4bc4849c4d5
# Optional pickup override (otherwise fetched automatically from Bosta dashboard):
# Remove placeholder values like your-district-id — they are ignored.
# BOSTA_PICKUP_LOCATION_ID=

# JWT settings
JWT_SECRET=your-jwt-secret-at-least-32-characters-long

# ─── Payment Gateways (Optional) ────────────────────────────────────────────
# Leave blank / remove to use COD-only mode.
# Add keys for any gateway you want to enable — they auto-activate.

# Stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Paymob (Egypt) — leave blank to use COD-only mode
# PAYMOB_SECRET_KEY=egy_sk_live_...
# PAYMOB_PUBLIC_KEY=egy_pk_live_...
# PAYMOB_CARD_INTEGRATION_ID=your-card-integration-id
# PAYMOB_WALLET_INTEGRATION_ID=your-wallet-integration-id
# PAYMOB_HMAC_SECRET=your-hmac-secret
# PAYMOB_BASE_URL=https://accept.paymob.com
